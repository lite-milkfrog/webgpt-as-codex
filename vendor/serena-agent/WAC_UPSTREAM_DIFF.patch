+                for candidate in candidates
+                if candidate.location != target.location
+                and (("/" in candidate.get_name_path()) == target_is_nested)
+            ]
+            implementation_fallback = "exact-name-and-kind"
 
         symbol_dicts = [
             dict(s.to_dict(kind=True, relative_path=True, depth=0, body=include_body, body_location=True)) for s in implementing_symbols
         ]
+        if implementation_fallback:
