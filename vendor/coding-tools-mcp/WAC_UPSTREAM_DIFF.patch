+        except ValueError as exc:
+            raise ToolFailure(
+                "PATH_OUTSIDE_REPOSITORY",
+                f"Path is not inside repository: {path}",
+                category="validation",
+            ) from exc
+        value = relative.as_posix()
+        return value if value not in {"", "."} else "."
