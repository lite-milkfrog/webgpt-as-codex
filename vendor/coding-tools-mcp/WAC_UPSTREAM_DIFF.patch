+    def _git_repo_root(self, path: Path, *, env: dict[str, str] | None = None) -> Path | None:
+        probe = path if path.is_dir() else path.parent
+        completed = self._run_git_text(
+            [require_git(), "-C", str(probe), "rev-parse", "--show-toplevel"],
+            env=env,
+        )
+        if completed.returncode != 0:
+            return None
+        root_text = completed.stdout.strip()
+        if not root_text:
+            return None
+        root = Path(root_text).resolve()
+        try:
+            root.relative_to(self.workspace.root.resolve())
+        except ValueError:
+            return None
+        return root
+
+    def _git_repo_filter(self, path: Path, repo_root: Path) -> str:
+        resolved = path.resolve()
