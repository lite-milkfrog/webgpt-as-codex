{
  "id": "playwright",
  "display_name": "Playwright MCP",
  "role": "browser_webapp",
  "required": true,
  "enabled_by_default": true,
  "upstream": "https://github.com/microsoft/playwright-mcp",
  "license": "Apache-2.0",
  "derivative_overlay": "src/webgpt_as_codex/playwright_hotfix.py",
  "derivative_distribution": "official npm package plus deterministic WebGPT source overlay",
  "transport": "streamable_http",
  "default_endpoint": "http://127.0.0.1:8931/mcp",
  "version_command": [],
  "process_contains": [
    "@playwright",
    "mcp"
  ],
  "install_hint": "webgpt-codex deploy --apply --component playwright",
  "bundled_source": "vendor/playwright-mcp",
  "bundled_derivative": true,
  "bundled_core_source": "vendor/playwright",
  "install": {
    "strategy": "bundled-npm",
    "package": "@playwright/mcp",
    "latest": {
      "source": "bundled",
      "version": "0.0.81",
      "path": "vendor/playwright-mcp",
      "upstream_ref": "v0.0.81",
      "upstream_commit": "e73d72e01f162054a3d0a6b0fe8d4affffb095ee",
      "playwright_core_version": "1.64.0-alpha-2026-09-14",
      "playwright_core_commit": "d1ead3ecca23182f2d06d761c28e3d4edafb6595"
    },
    "requirements": [
      "node",
      "npm"
    ],
    "compatibility": {
      "min_version": "0.0.80",
      "max_version_exclusive": "0.1.0"
    }
  },
  "safe_tool": "browser_snapshot",
  "ownership_mode": "external_local",
  "startup_priority": 45,
  "dependencies": [
    "mcpjungle"
  ],
  "readiness_contract": "mcp-initialize-tools-list",
  "gateway_exposure": "gateway"
}
