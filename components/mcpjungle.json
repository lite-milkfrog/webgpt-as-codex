{
  "id": "mcpjungle",
  "display_name": "MCPJungle",
  "role": "gateway",
  "required": true,
  "enabled_by_default": true,
  "upstream": "https://github.com/mcpjungle/MCPJungle",
  "license": "MPL-2.0",
  "transport": "streamable_http",
  "default_endpoint": "http://127.0.0.1:9330/mcp",
  "version_strategy": "resolve official GitHub Releases; verified latest during Stage 4 was 0.4.5",
  "verified_release": "0.4.5",
  "version_command": ["mcpjungle", "version"],
  "machine_binary": "bin/mcpjungle/mcpjungle.exe",
  "process_contains": ["mcpjungle", "start"],
  "install_hint": "download official GitHub release asset and verify checksums.txt",
  "safe_tool": null
}
