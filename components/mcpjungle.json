{
  "id": "mcpjungle",
  "display_name": "MCPJungle",
  "role": "gateway",
  "required": true,
  "enabled_by_default": true,
  "upstream": "https://github.com/mcpjungle/MCPJungle",
  "license": "MPL-2.0",
  "transport": "streamable_http",
  "default_endpoint": "http://127.0.0.1:9330/mcp",
  "version_strategy": "resolve official GitHub Releases; verified baseline during Stage 15 was 0.4.6",
  "verified_release": "0.4.6",
  "version_command": ["mcpjungle", "version"],
  "machine_binary": "bin/mcpjungle/mcpjungle.exe",
  "process_contains": ["mcpjungle", "start"],
  "install_hint": "download official GitHub release asset and verify its GitHub release SHA-256 digest",
  "install": {
    "strategy": "github-release",
    "latest": {"source": "github-release", "repo": "mcpjungle/MCPJungle"},
    "github_repo": "mcpjungle/MCPJungle",
    "assets": {
      "amd64": "mcpjungle_Windows_x86_64.zip",
      "arm64": "mcpjungle_Windows_arm64.zip"
    },
    "archive_member": "mcpjungle.exe",
    "destination": "bin/mcpjungle/mcpjungle.exe",
    "requirements": [],
    "compatibility": {"min_version": "0.4.5", "max_version_exclusive": "0.5.0"}
  },
  "safe_tool": null
}
