{
  "id": "coding-tools",
  "display_name": "Coding Tools MCP",
  "role": "code_execution",
  "required": true,
  "enabled_by_default": true,
  "upstream": "https://github.com/xyTom/coding-tools-mcp",
  "license": "Apache-2.0",
  "transport": "streamable_http",
  "default_endpoint": "http://127.0.0.1:8766/mcp",
  "version_command": [
    "coding-tools-mcp",
    "--version"
  ],
  "process_contains": [
    "coding-tools-mcp"
  ],
  "install_hint": "webgpt-codex deploy --apply --component coding-tools",
  "bundled_source": "vendor/coding-tools-mcp",
  "bundled_derivative": true,
  "install": {
    "strategy": "bundled-uv-tool",
    "package": "coding-tools-mcp",
    "latest": {
      "source": "bundled",
      "version": "0.3.0",
      "path": "vendor/coding-tools-mcp",
      "upstream_base": "bedb632e1afd2e9ec9b268a50fe0b04695c22c64"
    },
    "requirements": [
      "uv"
    ],
    "compatibility": {
      "min_version": "0.3.0",
      "max_version_exclusive": "0.4.0"
    }
  },
  "safe_tool": "server_info",
  "operating_guide": "skills/webgpt-as-codex/mcp-guides/coding-tools.md",
  "ownership_mode": "external_local",
  "startup_priority": 30,
  "dependencies": [
    "mcpjungle"
  ],
  "readiness_contract": "mcp-initialize-tools-list",
  "gateway_exposure": "gateway"
}
