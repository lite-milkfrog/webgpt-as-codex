{
  "id": "mcp-auth-proxy",
  "display_name": "mcp-auth-proxy",
  "role": "oauth_edge",
  "required": true,
  "enabled_by_default": true,
  "upstream": "https://github.com/sigbit/mcp-auth-proxy",
  "license": "MIT",
  "transport": "http",
  "default_endpoint": "http://127.0.0.1:9340",
  "verified_local_binary": "2.10.2-era mcp-warp binary",
  "compat_adapter": "webgpt_as_codex.oauth_compat",
  "version_command": [],
  "machine_binary": "bin/mcp-auth-proxy/mcp-auth-proxy.exe",
  "process_contains": ["mcp-auth-proxy"],
  "install_hint": "resolve the latest stable official release and require its GitHub SHA-256 digest",
  "install": {
    "strategy": "github-release",
    "latest": {"source": "github-release", "repo": "sigbit/mcp-auth-proxy"},
    "github_repo": "sigbit/mcp-auth-proxy",
    "assets": {
      "amd64": "mcp-auth-proxy-windows-amd64.exe",
      "arm64": "mcp-auth-proxy-windows-arm64.exe"
    },
    "destination": "bin/mcp-auth-proxy/mcp-auth-proxy.exe",
    "requirements": [],
    "compatibility": {"min_version": "2.10.2", "max_version_exclusive": "3.0.0"}
  },
  "safe_tool": null
}
