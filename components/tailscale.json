{
  "id": "tailscale",
  "display_name": "Tailscale",
  "role": "remote_transport",
  "required": true,
  "enabled_by_default": true,
  "upstream": "https://github.com/tailscale/tailscale",
  "license": "BSD-3-Clause core",
  "transport": "system",
  "default_endpoint": null,
  "version_command": ["tailscale", "version"],
  "process_contains": ["tailscaled"],
  "install_hint": "install Tailscale for Windows",
  "install": {
    "strategy": "winget",
    "winget_id": "Tailscale.Tailscale",
    "latest": {"source": "winget"},
    "requirements": ["winget"],
    "compatibility": {"min_version": "1.38.3", "max_version_exclusive": "2.0.0"}
  },
  "safe_tool": null
}
