{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wac://parallel-agent/stage-manifest.schema.json",
  "title": "WAC Parallel Agent Stage Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "stage_id",
    "orchestrator_id",
    "state",
    "base_head",
    "children"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "program_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "orchestrator_id": {"type": "string", "pattern": "00-ORCH$"},
    "state": {
      "enum": [
        "ORCHESTRATOR_BOOTSTRAP",
        "FANOUT_PLANNED",
        "DISPATCHING",
        "WAITING_FOR_CHILDREN",
        "MANUAL_FANIN_RESUME",
        "FANIN_RESCAN",
        "FANIN_READY",
        "BUILDING",
        "AUDITING",
        "STAGE_COMPLETE",
        "PARTIAL_CHILD_FAILURE",
        "PAUSED_EXTERNAL_BLOCKER",
        "USER_STOPPED"
      ]
    },
    "base_head": {"type": "string", "minLength": 7},
    "state_root": {"type": ["string", "null"]},
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "role",
          "task_path",
          "prompt_path",
          "dependencies",
          "ownership",
          "mandatory",
          "status"
        ],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["RESEARCH", "DEV", "REVIEW"]},
          "task_path": {"type": "string", "minLength": 1},
          "prompt_path": {"type": "string", "minLength": 1},
          "branch": {"type": ["string", "null"]},
          "worktree": {"type": ["string", "null"]},
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "ownership": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "mandatory": {"type": "boolean"},
          "status": {
            "enum": [
              "PLANNED",
              "PROMPT_READY",
              "DISPATCH_ATTEMPTED",
              "DISPATCHED",
              "TAKEOVER_CONFIRMED",
              "HANDOFF_READY",
              "FAILED",
              "BLOCKED",
              "SKIPPED"
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "DEV"}}},
            "then": {
              "required": ["branch", "worktree"],
              "properties": {
                "branch": {"type": "string", "minLength": 1},
                "worktree": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    }
  }
}

